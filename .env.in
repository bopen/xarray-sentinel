# Configure your CDSE S3 credentials: https://eodata-s3keysmanager.dataspace.copernicus.eu/panel/s3-credentials

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

AWS_ENDPOINT_URL=https://eodata.dataspace.copernicus.eu/
AWS_S3_ENDPOINT=eodata.dataspace.copernicus.eu
AWS_VIRTUAL_HOSTING=False

# Retry the failed GDAL HTTP reads, GDAL does not retry by default
GDAL_HTTP_MAX_RETRY=5
GDAL_HTTP_RETRY_DELAY=10

# S3 read controls
GDAL_MAX_RAW_BLOCK_CACHE_SIZE=67108864
CPL_VSIL_CURL_CACHE_SIZE=67108864
GTIFF_DIRECT_IO=YES
